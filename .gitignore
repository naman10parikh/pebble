# wikimem
.wikimem-cache/
node_modules/

# TypeScript build output (rebuilt fresh by CI `npm run build`)
dist/
# Test build output (npm test compiles tests here, then runs node --test on the .js)
dist-test/

# acceptance-test scaffold scratch dir
_acceptance/

# WikiMem test vault personal data
my-wiki/raw/
tools/agentgrid/app/release/

packages/web/.next/
*.pack

# macOS metadata
**/.DS_Store

# Ephemeral harness state (never commit)
.claude/worktrees/
.claude/backups/
.claude/scheduled_tasks.lock
.claude/vp-signals/*.done
.claude/vp-signals/*.needs-qa
.claude/vp-signals/*.migrating

# Obsidian temp files
vault/Untitled*.base

.env
.env.*
# …but the placeholder template IS committed (X1 — no real values in it).
!.env.example

# Nightly RSI proposals are regenerating dated outputs (like dist/) — the runner writes them on each
# run; the brain/research/ dir itself is tracked (.gitkeep) so a fresh clone has the mkdir target.
brain/research/proposed-*.md
