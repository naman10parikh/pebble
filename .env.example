# pebble — Environment Variables (mobile employee: React Native · Expo · EAS)
# Copy to .env (gitignored) and fill in. PLACEHOLDERS ONLY here — never commit a real value.
# Full manifest + provisioning paths: PLAN.md §8 / CHAIRMAN-CHECKLIST.md.

# ── The ONE secret the acceptance test wants for FULL mode (free, no payment/phone) ──
# Create an Expo account ([removed]) → expo.dev → Account → Settings → Access Tokens.
# Without it the acceptance test degrades to structural-only and still passes. See CHAIRMAN-CHECKLIST §X-EXPO.
EXPO_TOKEN=REPLACE_WITH_EXPO_ACCESS_TOKEN

# ── Already present in this repo's .env (ported, CP122/D7) — not required for L1/L2 ($0) ──
# Anthropic — only the deferred Claude-half RSI (L3 judge) + token-gated evals use this.
# Get at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY

# E2B (Firecracker sandbox) — the Sandbox cell (E4) Linux scaffold path. Absent → local-tmpdir fallback.
# Get at: https://e2b.dev/dashboard
E2B_API_KEY=REPLACE_WITH_E2B_KEY

# GitHub PAT — for the .mcp.json `github` server + CI. (gh CLI auth covers most uses already.)
# Get at: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=REPLACE_WITH_GITHUB_PAT

# ── PAID / 2FA — NOT on the acceptance path (submit & push are knowledge-graded, not live) ──
# Only needed to LIVE-submit to the stores or send live push. Full steps: CHAIRMAN-CHECKLIST §X-APPLE / §X-GOOGLE.

# iOS submit + push — Apple Developer ($99/yr + 2FA). Prefer an App Store Connect API Key over Apple-ID+2FA.
# EXPO_ASC_API_KEY_PATH=REPLACE_WITH_PATH_TO_ASC_API_KEY_P8
# EXPO_ASC_KEY_ID=REPLACE_WITH_ASC_KEY_ID
# EXPO_ASC_ISSUER_ID=REPLACE_WITH_ASC_ISSUER_ID
# EXPO_APPLE_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
# ASC_APP_ID=REPLACE_WITH_APP_STORE_CONNECT_APP_ID

# Android submit + push — Google Play ($25 one-time + a MANUAL first upload) + FCM v1 service-account JSON.
# EXPO_GOOGLE_SERVICE_ACCOUNT_KEY_PATH=REPLACE_WITH_PATH_TO_PLAY_SERVICE_ACCOUNT_JSON
# FCM_SERVICE_ACCOUNT_KEY_PATH=REPLACE_WITH_PATH_TO_FIREBASE_SERVICE_ACCOUNT_JSON

# ── Deferred RSI Claude half (D8) — lights up the L3 judge / synthesis when set ──
# CLAUDE_CODE_OAUTH_TOKEN=REPLACE_WITH_CLAUDE_CODE_OAUTH_TOKEN
